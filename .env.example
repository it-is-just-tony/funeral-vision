# Helius API Key (get free key at https://dev.helius.xyz/)
HELIUS_API_KEY=your_helius_api_key_here

# Birdeye API Key (get free key at https://birdeye.so/)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# API Server Port
PORT=3001

# Web Server Port
WEB_PORT=3000

# Database Path
DATABASE_PATH=./data/pnl.db

# ===================
# Authentication
# ===================

# JWT Secret (REQUIRED - generate a random 32+ character string)
# Example: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-min-32-chars

# Owner email - this user gets unlimited wallets and full admin access
# The first time you register with this email, you'll be set as owner
OWNER_EMAIL=your@email.com

# Google OAuth (OPTIONAL - for "Continue with Google" login)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173
